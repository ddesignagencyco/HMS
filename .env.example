NODE_ENV=development
PORT=3000
API_HOST=0.0.0.0

# The worker's Prometheus scrape port. The API serves /metrics on PORT; the worker is a separate
# process and exposes its own registry here, because the background jobs the metrics count run in
# the worker. Prometheus scrapes both (see ops/prometheus/prometheus.yml).
WORKER_METRICS_PORT=9464

# Host port bindings for infra/docker-compose.yml. Change these if 5432/6379 are
# already taken on the host; keep DATABASE_URL and REDIS_URL in sync.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# connection_limit=25&pool_timeout=30: SHM-094's depart/start timing-gate tests and
# booking-checkout.test.ts's "50 concurrent checkouts for one slot" test both open many
# simultaneous transactions. 10 connections queued past Prisma's default 10s pool_timeout
# under that load and surfaced as raw 500s instead of the 409 SLOT_TAKEN the test expects.
DATABASE_URL=postgresql://smart_home:smart_home@localhost:5432/smart_home?schema=public&connection_limit=25&pool_timeout=30
DIRECT_URL=postgresql://smart_home:smart_home@localhost:5432/smart_home?schema=public

REDIS_URL=redis://localhost:6379

# The API's own port is the first entry; :3001 is the web app's, which reaches the
# API through its rewrite and is therefore same-origin in the browser. Listed so
# a direct browser call from the dev server is not refused if the proxy is ever
# bypassed. Keep in step with whatever `next dev -p <port>` is pinned to.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# The web app's origin, not the API's — this is where customers are sent. The
# verification link they are texted, the problem-report link on a receipt and the
# gateway's payment return URL are all built from it, so it must be the web app's
# address and must be set per deployment.
PUBLIC_BASE_URL=http://localhost:3001
LOG_LEVEL=info
SHUTDOWN_GRACE_MS=10000

JWT_ACCESS_SECRET=development-access-secret-change-me-32-chars
JWT_REFRESH_SECRET=development-refresh-secret-change-me-32-chars
JWT_ISSUER=smart-home-api
JWT_AUDIENCE=smart-home-clients
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
CSRF_SECRET=development-csrf-secret-change-me-32-chars

OTP_PEPPER=development-otp-pepper-change-me-32-chars
TOTP_ENCRYPTION_KEY=Jv5W3JV09kkaHVhT8+vYV6wGykvZdCHHjcQ4Ml64utM=
CNIC_ENCRYPTION_KEY=DRQbIikwNz5FTFNaYWhvdn2Ei5KZoKeutbzDytHY3+Y=

PAYMENT_PROVIDER=mock
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
MAPS_PROVIDER=mock
TELEPHONY_PROVIDER=mock
WHATSAPP_PROVIDER=mock
STORAGE_PROVIDER=mock
MOCK_PAYMENT_WEBHOOK_SECRET=development-webhook-secret

STORAGE_BUCKETS=evidence,documents,recordings,reports

# Supabase Storage & Auth (set STORAGE_PROVIDER=supabase to enable)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_STORAGE_BUCKET=verification-documents
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

DEV_INBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000