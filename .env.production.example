# SHM-094 · production environment template.
#
# Copy this to `.env` on the deployment host (or store the same keys as deploy secrets) and
# fill in real values. The app validates every one of these at boot
# (apps/api/src/config/environment.schema.ts) and refuses to start in production if a
# development secret is reused, the dev inbox is on, or a provider other than "mock" is set.
#
# Generate fresh secrets. The four base64 keys must each be exactly 32 bytes; the four
# string secrets must be at least 32 characters and all different from one another:
#
#   openssl rand -base64 32   # TOTP_ENCRYPTION_KEY, CNIC_ENCRYPTION_KEY
#   openssl rand -hex 32      # JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, CSRF_SECRET, OTP_PEPPER
#
# Never commit the filled-in file. `.gitignore` ignores `.env` and `.env.*`; this template
# is the one deliberate exception.

NODE_ENV=production
LOG_LEVEL=info

# --- image selection (read by infra/docker-compose.prod.yml) ---------------------------
# IMAGE_REGISTRY is <owner>/<repo> on GHCR, e.g. ghcr.io/acme/smart-home.
IMAGE_REGISTRY=ghcr.io/your-org/your-repo
IMAGE_TAG=latest

# --- datastores ------------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-strong-db-password
REDIS_PASSWORD=change-me-strong-redis-password
DB_CONNECTION_LIMIT=10

# --- web app ---------------------------------------------------------------------------
# The web app's origin, not the API's. The verification link, receipt link and gateway
# return URL are all built from PUBLIC_BASE_URL, so it must be the browser-facing address.
PUBLIC_BASE_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# --- secrets (fresh, per environment; nothing reused from .env.example) ----------------
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-with-a-different-openssl-rand-hex-32
CSRF_SECRET=replace-with-a-third-openssl-rand-hex-32
OTP_PEPPER=replace-with-a-fourth-openssl-rand-hex-32
TOTP_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
CNIC_ENCRYPTION_KEY=replace-with-a-different-openssl-rand-base64-32
MOCK_PAYMENT_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# --- optional --------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_MIN_LEVEL=error
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Host port bindings (change if 3000/9090 are taken on the host).
API_HOST_PORT=3000
PROMETHEUS_HOST_PORT=9090

# --- fixed by the current increment ----------------------------------------------------
# Only the mock adapters are wired (OQ-03 / OQ-04); the schema rejects anything else.
PAYMENT_PROVIDER=mock
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
MAPS_PROVIDER=mock
TELEPHONY_PROVIDER=mock
WHATSAPP_PROVIDER=mock
STORAGE_PROVIDER=mock
STORAGE_BUCKETS=evidence,documents,recordings,reports

# Must stay false in production; the schema refuses to boot with it on.
DEV_INBOX_ENABLED=false
